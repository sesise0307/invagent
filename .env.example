TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash

# Used only while configuring each agent's private OpenDART MCP endpoint.
# Never commit a real value or embed it in a tracked URL.
OPENDART_API_KEY=your_opendart_api_key_here

# StockEasy session cookie, used by analyze-stock for quote, multiples, consensus,
# news, and broker report summaries. Every endpoint except `stock-search` returns
# HTTP 401 without it. Copy the whole Cookie request header from a logged-in
# browser tab. Never commit a real value.
# STOCKEASY_COOKIE=name=value; other=value

# data.go.kr service key for 금융위원회_주식시세정보 (official KRX daily bars).
# Judgement bars come from it first; without it they fall back to StockEasy.
# DATA_GO_KR_SERVICE_KEY=your_data_go_kr_service_key

# Optional
# TELEGRAM_SESSION_PATH=~/.telegram_session
# INVAGENT_OUTPUT_DIR=output
# INVAGENT_DEFAULT_CHANNELS=DOC_POOL,선진짱 주식공부방,report_figure_by_offset,YoungTiger_stock,quick_report
