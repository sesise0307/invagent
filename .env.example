TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash

# Used only while configuring each agent's private OpenDART MCP endpoint.
# Never commit a real value or embed it in a tracked URL.
OPENDART_API_KEY=your_opendart_api_key_here

# StockEasy session cookie, used only by analyze-stock to read broker report
# summaries (`securities-reports` returns HTTP 401 without it). Copy the whole
# Cookie request header from a logged-in browser tab. Never commit a real value.
# STOCKEASY_COOKIE=name=value; other=value

# Optional
# TELEGRAM_SESSION_PATH=~/.telegram_session
# INVAGENT_OUTPUT_DIR=output
# INVAGENT_DEFAULT_CHANNELS=DOC_POOL,sunstudy1004,report_figure_by_offset,YoungTiger_stock,quick_report
